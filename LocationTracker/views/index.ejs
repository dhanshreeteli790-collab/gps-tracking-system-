<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Real-Time Tracking App</title>

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>

    <style>
      *{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family: Arial;
   }

   body{
    display:flex;
    height: 100vh;
   }


.profile{
    text-align: center;
    padding: 15px;
    border-bottom: 1px solid #333;
    margin-bottom: 10px;
}

.profile img{
    width: 70px;
    height: 70px;
    border-radius: 50%;
    margin-bottom: 10px;
    border: 2px solid #00ffcc;
}

.profile h3{
    margin: 5px 0;
    color: #00ffcc;
    font-size: 18px;
}

.profile p{
    font-size: 12px;
    color: #aaa;
}




   /*sidebar*/
   #sidebar{
    width: 30%;
    background: #111;
    color: white;
    overflow-y: auto;
    padding: 10px;
   }

   #sidebar h2{
    text-align: center;
    margin-bottom: 10px;
   }
   .user{
    background: #222;
    padding: 10px;
    margin: 8px 0;
    cursor: pointer;
    transition: 0.3s;
   }

   .user:hover{
    background: #333;

   }

   .username{
    font-weight: bold;
    color: #00ffcc;

   }

   /*map*/
   #map{
    width:70%;
    height: 100%;

   }

   /*header*/
   .header{
    text-align: center;
    padding: 10px;
    background: #000;
    color: #00ffcc;
    font-weight: bold;
   }
    </style>
</head>

<body>

   <div id="sidebar">
  <div class="header">Track My Live Journey</div>

  <div class="profile">
      <img src="https://ui-avatars.com/api/?name=<%= username %>&background=00ffcc&color=000">
      <h3><%= username %></h3>
      <p>Online</p>
  </div>

  <div id="users"></div>
</div>

    <div id="map"></div>

    <!-- Leaflet JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

    <!-- Socket -->
    <script src="/socket.io/socket.io.js"></script>

    <!-- Your JS -->
    <script src="/js/userMap.js"></script>

    <script>
    const username = "<%= username %>";
</script>
</body>
</html>